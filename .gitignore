# Local Python environments and generated interpreter/test caches.
.venv/
.offline-venv/
__pycache__/
.pytest_cache/
.cupy_cache/
*.py[cod]
.coverage
htmlcov/

# Dense interaction matrices are rebuilt from the tracked model/mesh inputs.
*.npy

# Large FMM inputs/results are regenerated from the retained native AEDT mesh.
/validation/20261109_fmm_refined/large_export/
/validation/20261109_fmm_refined/large_fmm_worker.json*
# Rebuildable numeric H cache for native-AEDT disk-transfer verification.
/validation/20261109_fmm_refined/native_transfer/**/boundary_cache/
# Superseded failed export attempts are captured in fmm_verification.json.
/validation/20261109_fmm_refined/native_transfer/bundle/
/validation/20261109_fmm_refined/native_transfer/native_export.json

# Native Maxwell projects, result databases, mesh dumps, and temporary exports.
*.aedt
*.aedt.lock
*.aedtresults/
*.batchinfo/
*.pyaedt/
*.aedtplt
*.solinfo
*.completed

# Console logs and generated distribution archives remain local.
*.log
*.zip

# Downloaded manufacturer documents; source URLs are recorded in provenance JSON.
/validation/**/VAC*.pdf
/validation/**/MUMETALL_Strip.pdf
/validation/**/VAC_text.txt

# Editor and operating-system metadata.
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
